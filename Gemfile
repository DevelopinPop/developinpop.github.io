source "https://rubygems.org"

# This mirrors the exact gem versions GitHub Pages uses in production,
# so what you see locally matches what gets deployed.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
end

# Windows/JRuby support
gem "tzinfo", ">= 1", "< 3"
gem "tzinfo-data"
gem "wdm", "~> 0.1.1", :platforms => [:x64_mingw, :mingw]
